# ─── Database ────────────────────────────────────────────
# MongoDB Atlas: replace the username, URL-encoded password and cluster hostname.
DATABASE_URL="mongodb+srv://asms_app:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/scholarship_db?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000"
# Optional local development connection:
# DATABASE_URL="mongodb://127.0.0.1:27018/scholarship_db?replicaSet=rs0&directConnection=true&serverSelectionTimeoutMS=5000"

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_me_32chars
JWT_REFRESH_SECRET=your_refresh_secret_here_change_me_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AWS S3 (or MinIO) ──────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1
AWS_S3_BUCKET=scholarship-docs
AWS_S3_ENDPOINT=http://localhost:9000

# ─── Email (SMTP) ───────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_key
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@scholarship.edu

# ─── Frontend ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
