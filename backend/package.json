{
  "name": "scholarship-backend",
  "version": "1.0.0",
  "description": "Adaptive Scholarship Management System - Backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/app.js",
    "start:cloud": "prisma db push --skip-generate && node dist/app.js",
    "prisma:generate": "prisma generate",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mongodb.ps1",
    "db:push": "prisma db push",
    "db:check": "tsx scripts/check-database.ts",
    "db:test": "tsx scripts/verify-database.ts",
    "db:setup": "prisma generate && prisma db push && tsx scripts/check-database.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "jest --passWithNoTests"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@prisma/client": "^5.12.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.12",
    "puppeteer": "^22.6.0",
    "streamifier": "^0.1.1",
    "winston": "^3.12.0",
    "zod": "^3.22.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.28",
    "@types/nodemailer": "^6.4.14",
    "@types/streamifier": "^0.1.2",
    "jest": "^29.7.0",
    "prisma": "^5.12.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "devDependencies": {}
}
