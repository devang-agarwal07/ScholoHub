generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── MODELS ───────────────────────────────────────────────

model User {
  id              String           @id @default(cuid()) @map("_id")
  email           String           @unique
  passwordHash    String
  role            String
  profile         Profile?
  applications    Application[]
  assignedDocs    DocumentReview[]
  workflowActions WorkflowAction[]
  refreshToken    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([role, createdAt(sort: Desc)])
  @@map("users")
}

model Profile {
  id          String    @id @default(cuid()) @map("_id")
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  phone       String?
  dateOfBirth DateTime?
  address     String?
  institution String?
  department  String?
  yearOfStudy Int?
  cgpa        Float?
  avatarUrl   String?

  @@map("profiles")
}

model Scholarship {
  id                  String        @id @default(cuid()) @map("_id")
  name                String
  description         String
  totalBudget         Float
  perAwardAmount      Float
  maxAwardees         Int
  eligibilityCriteria Json
  requiredDocuments   Json
  applicationDeadline DateTime
  academicYear        String
  isActive            Boolean       @default(true)
  applications        Application[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([isActive, applicationDeadline])
  @@index([academicYear])
  @@map("scholarships")
}

model Application {
  id                String            @id @default(cuid()) @map("_id")
  studentId         String
  student           User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scholarshipId     String
  scholarship       Scholarship       @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  status            String            @default("DRAFT")
  personalStatement String?
  familyIncome      Float?
  academicDetails   Json?
  submittedAt       DateTime?
  documents         Document[]
  workflowStages    WorkflowAction[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([studentId, scholarshipId])
  @@index([studentId, updatedAt(sort: Desc)])
  @@index([scholarshipId, status])
  @@index([status, updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("applications")
}

model Document {
  id            String         @id @default(cuid()) @map("_id")
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  String
  fileName      String
  s3Key         String
  s3Url         String
  status        String         @default("PENDING")
  reviews       DocumentReview[]
  uploadedAt    DateTime       @default(now())

  @@index([applicationId, documentType])
  @@index([status, uploadedAt])
  @@map("documents")
}

model DocumentReview {
  id         String         @id @default(cuid()) @map("_id")
  documentId String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status     String
  remarks    String?
  reviewedAt DateTime       @default(now())

  @@index([documentId, reviewedAt(sort: Desc)])
  @@index([reviewerId, reviewedAt(sort: Desc)])
  @@map("document_reviews")
}

model WorkflowAction {
  id            String        @id @default(cuid()) @map("_id")
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  stage         String
  action        String
  remarks       String?
  createdAt     DateTime      @default(now())

  @@index([applicationId, createdAt])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("workflow_actions")
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([entity, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
